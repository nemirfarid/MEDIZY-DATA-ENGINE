# ==============================================================================
# MEDIZY / SANTÉ DZ — Fichier d'exclusion Git (.gitignore)
# ==============================================================================

# Fichiers d'environnement, secrets et certificats
.env
.env.*
.env.production
.env.local
.env.test
!.env.example
*.pem
*.key
*.cert

# Sauvegardes, dumps et bases de données
*.dump
*.dump.*
backups/
*.sql
!medizy_pipeline/sql/*.sql
*.db
*.db-journal
*.db-wal
*.db-shm

# Environnement Python & Tests
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Logs, audits et exports temporaires
*.log
*.tmp
*.bak
*.pdf
*.jsonl
*.gz
exports/
.mobile_cache/
ingestion_report.json


# Flutter, Dart & Mobiles
.dart_tool/
build/
*.dll
pubspec.lock
dist/*.apk
*.apk

# Assets embarqués de l'application cliente
!assets/data/*

