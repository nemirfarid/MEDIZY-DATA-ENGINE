# ==============================================================================
# MEDIZY / SANTÉ DZ — Configuration des Variables d'Environnement (Production)
# ==============================================================================

# 1. Base de données spatiale PostgreSQL / PostGIS & Tuning de Performance
DATABASE_URL=postgresql://medizy_user:medizy_password@postgis:5432/medizy_db
POSTGRES_DB=medizy_db
POSTGRES_USER=medizy_user
POSTGRES_PASSWORD=medizy_password
POSTGRES_HOST=postgis
POSTGRES_PORT=5432

# Paramétrage du Pool de Connexions (psycopg_pool / ThreadedConnectionPool)
DB_POOL_MIN_SIZE=10
DB_POOL_MAX_SIZE=50
DB_POOL_TIMEOUT=10.0

# Tuning Mémoire & Stockage PostgreSQL 16 (optimisé SSD/NVMe)
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_WORK_MEM=32MB
POSTGRES_MAINT_WORK_MEM=128MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1536MB
POSTGRES_MAX_CONNECTIONS=200
READ_ONLY_MODE=false


# 2. Cache & Limitation de Débit (Redis 7)
REDIS_URL=redis://redis:6379/0

# 3. Sécurité Administrateur & Authentification JWT (RFC 7519)
ADMIN_JWT_SECRET=MedizyProductionSecr3tKey2026!ChangeInProd!
ADMIN_API_KEY=medizy-admin-secret-key-2026
ADMIN_USERNAME=admin@medizy.dz
ADMIN_PASSWORD=MedizyAdmin2026!
CORS_ORIGINS=https://medizy.dz,https://admin.medizy.dz,http://localhost:3000

# 4. Planification & Ingestion Nocturne (Scheduler)
INGEST_SCHEDULE_TIME=02:00
INGEST_DELAY_SECONDS=3.0
INGEST_ALL_WILAYAS=true
INGEST_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/T00/B00/XXXXX

# 5. Sauvegardes & Disaster Recovery (S3)
BACKUP_DIR=/var/backups/medizy
RETENTION_DAYS=14
S3_BUCKET=s3://medizy-backups-dz/postgis/
WEBHOOK_URL=https://hooks.slack.com/services/T00/B00/XXXXX

# 6. Observabilité & Métriques Prometheus
ENABLE_METRICS=true

# 7. Enrichissement Optionnel (Google Places)
GOOGLE_PLACES_API_KEY=
